rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para verificar si el usuario es Superadmin
    function isSuperAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Función para verificar si el usuario es Admin del tenant específico
    function isAdminOf(tenantId) {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId;
    }

    // --- REGLAS DE USUARIOS ---
    match /users/{userId} {
      // Solo el Superadmin o el propio usuario pueden ver su perfil
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      // Permitir creación al propio usuario autenticado (registro) y permitir actualizar al propio usuario o Superadmin.
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      // Solo el Superadmin puede cambiar roles o borrar usuarios
      allow delete: if isSuperAdmin();
    }

    // --- REGLAS DE TENANTS (Restaurantes) ---
    match /tenants/{tenantId} {
      // El público puede leer la info básica del restaurante
      allow read: if true;
      
      // Solo Superadmin puede crear o borrar restaurantes
      allow create, delete: if isSuperAdmin();
      
      // El Admin del restaurante o Superadmin pueden editar la info
      allow update: if isSuperAdmin() || isAdminOf(tenantId);

      // --- SUB-COLECCIÓN: MENÚ ---
      match /menu/{productId} {
        // El público puede ver el menú
        allow read: if true;
        // Solo el Admin del tenant o Superadmin pueden modificar productos
        allow write: if isSuperAdmin() || isAdminOf(tenantId);
      }

      // --- SUB-COLLECTION: ORDERS ---
      match /orders/{orderId} {
        // Public order created without login; strict validation to avoid garbage
        allow create: if request.resource.data.keys().hasOnly([
                          'tenantId',
                          'customerName',
                          'customerPhone',
                          'items',
                          'total',
                          'createdAt',
                          'status',
                          'paymentMethod',
                          'source'
                        ])
                      && request.resource.data.tenantId == tenantId
                      && request.resource.data.customerName is string
                      && request.resource.data.customerName.size() >= 2
                      && request.resource.data.customerName.size() <= 80
                      && request.resource.data.customerPhone is string
                      && request.resource.data.customerPhone.size() >= 10
                      && request.resource.data.customerPhone.size() <= 15
                      && request.resource.data.items is list
                      && request.resource.data.items.size() > 0
                      && request.resource.data.items.size() <= 30
                      && request.resource.data.total is number
                      && request.resource.data.total > 0
                      && request.resource.data.status == 'new'
                      && request.resource.data.paymentMethod in ['pickup','stripe']
                      && request.resource.data.source == 'public_menu';

        // Read: only Superadmin or tenant Admin
        allow read: if isSuperAdmin() || isAdminOf(tenantId);
        
        // Update: only tenant Admin or Superadmin
        allow update: if isSuperAdmin() || isAdminOf(tenantId);
        
        // Delete: only Superadmin
        allow delete: if isSuperAdmin();
      }
    }
  }
}
